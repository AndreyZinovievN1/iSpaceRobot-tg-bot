# iSpaceRobot — example environment file.
# Copy it to `.env` and fill in your own values. Never commit `.env`.

# --- Telegram bot -------------------------------------------------------
TOKEN=
OWNER_ID=

# --- Pyrogram (MTProto) credentials, used by userbots -------------------
# Get them at https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# --- LLM providers: rotating key pool -----------------------------------
API_KEY_1=
API_KEY_2=
API_KEY_3=

# --- PostgreSQL ---------------------------------------------------------
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# --- Redis --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
